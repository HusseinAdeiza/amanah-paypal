{
  "name": "amanah",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Amanah — autonomous, auditable treasury agent for charities & NGOs, built on PayPal (PayPal AI Hackathon 2026)",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "demo": "pnpm --filter @amanah/agent run demo",
    "cli": "pnpm --filter @amanah/agent run cli",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": { "typescript": "^5.5.0" },
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=20.0.0" }
}
