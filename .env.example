# Amanah — PayPal AI Hackathon
# Copy to agent/.env and web/.env as needed. DRY_RUN=true needs NO keys (default, safe).

# --- AI reasoner (optional; heuristic runs with no key) ---
# Any OpenAI-compatible endpoint. Example: OpenAI, or a local/Ollama server.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- PayPal (optional; sandbox mock runs with no keys) ---
# Get sandbox creds at developer.paypal.com (5 min). Leave blank for mock mode.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- IPFS (optional; mock runs with no key) ---
IPFS_PROVIDER=mock
PINATA_JWT=
WEB3_STORAGE_TOKEN=

# --- Runtime ---
DRY_RUN=true
PORT=4000
